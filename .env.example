# GENESIS PURE LIFESCIENCES — environment variables
# Copy to .env.local for development; set the same in Vercel for production.
# Never commit a filled-in copy.

# Production domain (canonical URLs, sitemap, Open Graph). Required in production.
NEXT_PUBLIC_SITE_URL=

# Admin login. Generate the hash and secret with:  npm run admin:hash -- "passphrase"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Optional editor account: can manage Notices and Insights only (no products,
# partners, settings, enquiries or backups). Hash it the same way as above.
EDITOR_EMAIL=
EDITOR_PASSWORD_HASH=

# Persistent storage. REQUIRED on Vercel (serverless disk is read-only).
# Create a Blob store in Vercel → Storage and link it to the project.
# Without it, content is stored in ./.data (local development only).
BLOB_READ_WRITE_TOKEN=
# CONTENT_STORAGE_DIR=.data

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Preview deployment: true keeps the site out of search engines (noindex, robots
# disallow-all, empty sitemap). It never changes what pages show.
# Defaults: true in development and Vercel previews, false in production.
# CONTENT_REVIEW_MODE=
